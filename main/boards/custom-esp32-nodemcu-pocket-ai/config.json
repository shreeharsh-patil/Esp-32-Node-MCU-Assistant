{
  "type": "custom-esp32-nodemcu-pocket-ai",
  "target": "esp32",
  "builds": [
    {
      "name": "custom-esp32-nodemcu-pocket-ai",
      "sdkconfig_append": [
        "CONFIG_SPIRAM=n",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/custom-pocket-4m.csv\"",
        "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
        "CONFIG_ESPTOOLPY_FLASHFREQ_40M=y",
        "CONFIG_FLASH_NONE_ASSETS=y",
        "CONFIG_ALLOW_FIRMWARE_UPDATES=n",
        "CONFIG_PREFER_WEBSOCKET=y",
        "CONFIG_AUDIO_TEST_DURATION_MS=2000",
        "CONFIG_ENABLE_DYNAMIC_GLYPH_PUSH=n",
        "CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=n",
        "CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n",
        "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n",
        "CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=y",
        "CONFIG_BT_ENABLED=n",
        "CONFIG_LV_FONT_MONTSERRAT_20=y",
        "CONFIG_LV_USE_LODEPNG=n",
        "CONFIG_LV_USE_GIF=n",
        "CONFIG_LV_CACHE_DEF_SIZE=0",
        "CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=0",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y",
        "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4",
        "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6",
        "CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6",
        "CONFIG_POCKET_HARDWARE_DIAGNOSTICS=n",
        "CONFIG_POCKET_CUSTOM_BACKEND=y"
      ]
    },
    {
      "name": "custom-esp32-nodemcu-pocket-ai-diagnostics",
      "sdkconfig_append": [
        "CONFIG_SPIRAM=n",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/custom-pocket-4m.csv\"",
        "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
        "CONFIG_ESPTOOLPY_FLASHFREQ_40M=y",
        "CONFIG_FLASH_NONE_ASSETS=y",
        "CONFIG_ALLOW_FIRMWARE_UPDATES=n",
        "CONFIG_PREFER_WEBSOCKET=y",
        "CONFIG_AUDIO_TEST_DURATION_MS=2000",
        "CONFIG_ENABLE_DYNAMIC_GLYPH_PUSH=n",
        "CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=n",
        "CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n",
        "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n",
        "CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=y",
        "CONFIG_BT_ENABLED=n",
        "CONFIG_LV_FONT_MONTSERRAT_20=y",
        "CONFIG_LV_USE_LODEPNG=n",
        "CONFIG_LV_USE_GIF=n",
        "CONFIG_LV_CACHE_DEF_SIZE=0",
        "CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=0",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y",
        "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4",
        "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6",
        "CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6",
        "CONFIG_POCKET_HARDWARE_DIAGNOSTICS=y",
        "CONFIG_POCKET_CUSTOM_BACKEND=n"
      ]
    }
  ]
}
